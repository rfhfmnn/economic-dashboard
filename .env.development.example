# ==============================================================================
# Development Environment Configuration Template (.env.development)
# ==============================================================================

# Application Port and Host (Dev default: 8000)
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL Dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=economic_dashboard_dev
POSTGRES_PORT=5432

# Connection string used by the app (defaults automatically to the above in docker-compose.dev.yaml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/economic_dashboard_dev

# Application Options
FORCE_MOCK=false
BCRA_USE_MOCKS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Container Image (Optional: pull prebuilt image from registry instead of local build)
# APP_IMAGE=ghcr.io/rfhfmnn/economic-dashboard:dev-current

# OpenTelemetry Telemetry Configuration
OTEL_SERVICE_NAME=economic-dashboard-backend-dev
ENVIRONMENT=development
DEPLOYED_VERSION=0.1.0-dev
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_TRACES_EXPORTER=console
