# ==============================================================================
# Observability Stack Environment Configuration (.env)
# ==============================================================================
# Port overrides and security settings for the separate observability stack.

# OpenTelemetry Collector Ports
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Storage & Backend Service Ports
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200

# Grafana Dashboard UI & Admin Credentials
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
