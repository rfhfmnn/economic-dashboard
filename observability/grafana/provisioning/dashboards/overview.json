      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Rate of single CUIT vs. batch portfolio screening evaluations filtered by environment and deployed version",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Evaluations / sec",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 0,
        "y": 7
      },
      "id": 201,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (screen_type, environment) (rate(economic_dashboard_cuit_screen_requests_total{environment=~\"$environment\", deployed_version=~\"$deployed_version\"}[1m]))",
          "legendFormat": "{{screen_type}} [{{environment}}]",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CUIT Screening Velocity",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Distribution of debtors evaluated by BCRA Situación (1 Normal to 6 Irrecuperable por disposición técnica)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Debtors / sec",
            "fillOpacity": 30,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 9,
        "x": 9,
        "y": 7
      },
      "id": 202,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (situation) (rate(economic_dashboard_debtor_risk_distribution_total{environment=~\"$environment\", deployed_version=~\"$deployed_version\"}[5m]))",
          "legendFormat": "Situación {{situation}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Debtor Risk Classification (Situación 1-6)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Percentage of debtor lookups satisfied by local database cache without hitting external BCRA APIs",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 18,
        "y": 7
      },
      "id": 203,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_max((sum(rate(economic_dashboard_cuit_cache_hits_total{environment=~\"$environment\", deployed_version=~\"$deployed_version\"}[5m])) / (sum(rate(economic_dashboard_cuit_cache_hits_total{environment=~\"$environment\", deployed_version=~\"$deployed_version\"}[5m])) + sum(rate(economic_dashboard_cuit_cache_misses_total{environment=~\"$environment\", deployed_version=~\"$deployed_version\"}[5m])) + 0.00001)) * 100, 100)",
          "legendFormat": "Cache Hit %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CUIT Cache Hit %",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Tax ID validation rejections caught by AFIP Módulo 11 checksum algorithm in the selected environment",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
