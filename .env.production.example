# ==============================================================================
# Production Environment Configuration Template (.env.production)
# ==============================================================================

# Application Port and Host (Prod default: 8080 to avoid collision with Dev 8000)
PORT=8080
HOST=0.0.0.0

# Database Configuration (PostgreSQL Production)
# NOTE: Set a strong, secure password in production!
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_production_password
POSTGRES_DB=economic_dashboard_prod
POSTGRES_PORT=5433

# Connection string used by the app (defaults automatically to the above in docker-compose.prod.yaml)
DATABASE_URL=postgresql://postgres:replace_with_secure_production_password@localhost:5433/economic_dashboard_prod

# Application Options
FORCE_MOCK=false
BCRA_USE_MOCKS=false
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30

# Container Image (Optional: pull prebuilt image from registry instead of local build)
# APP_IMAGE=ghcr.io/rfhfmnn/economic-dashboard:prod-current
