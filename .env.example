# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# The repository supports two independent, isolated environments:
#   - Development: .env.development.example (Ports: 8000 / 5432, DB: economic_dashboard_dev)
#   - Production:  .env.production.example  (Ports: 8080 / 5433, DB: economic_dashboard_prod)
#
# Below are default settings matching development:
# ==============================================================================

# Application Port and Host
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=economic_dashboard_dev
POSTGRES_PORT=5432

# Connection string used by the app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/economic_dashboard_dev

# Application Options
FORCE_MOCK=false
BCRA_USE_MOCKS=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
