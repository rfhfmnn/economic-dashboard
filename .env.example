# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Application Port and Host
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=economic_dashboard
POSTGRES_PORT=5432

# Connection string used by the app (defaults automatically to the above in docker-compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/economic_dashboard

# Application Options
FORCE_MOCK=false
BCRA_USE_MOCKS=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
